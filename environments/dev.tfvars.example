# Complete customer example. Copy values into the selected environment tfvars.

subscription_id = "00000000-0000-0000-0000-000000000000"
environment     = "dev" # Allowed: dev, staging, prod.

# Import decision applies only to Defender pricing/settings, never to LAW.
# false = configured Defender objects do not exist (greenfield).
# true = adopt existing Defender objects (brownfield). An existing LAW is ignored.
adopt_existing_resources = false

security_contact_email = "security@example.com"
security_contact_phone = null

assign_security_benchmark = true
enable_mde_integration    = true
enable_mdvm               = true

# Servers P1 default. For P2, use the README P2 block and set this to true.
enable_agentless_vm_scanning = false

defender_plans = {
  # P1 is the lower-cost default. Replace this block with the README P2 block
  # when the customer approves P2 and its agentless scanning capability.
  VirtualMachines = {
    subplan = "P1"
  }
  AppServices                   = {}
  SqlServers                    = {}
  SqlServerVirtualMachines      = {}
  OpenSourceRelationalDatabases = {}
  CosmosDbs                     = {}
  CloudPosture                  = {}
  StorageAccounts = {
    subplan = "DefenderForStorageV2"
    extensions = {
      OnUploadMalwareScanning = { enabled = true }
      SensitiveDataDiscovery  = { enabled = true }
    }
  }
  Containers = {
    extensions = {
      ContainerRegistriesVulnerabilityAssessments = { enabled = true }
      AgentlessDiscoveryForKubernetes              = { enabled = true }
      AgentlessVmScanning                          = { enabled = true }
      ContainerSensor                              = { enabled = true }
      ContainerIntegrityContribution               = { enabled = true }
    }
  }
  AI = {
    extensions = {
      AIModelScanner             = { enabled = true }
      AIPromptEvidence           = { enabled = true }
      AIPromptSharingWithPurview = { enabled = true }
    }
  }
  Api = {
    subplan = "P1"
  }
  KeyVaults = {
    subplan = "PerKeyVault"
  }
  Arm = {
    subplan = "PerSubscription"
  }
}